# @BotFather-დან
BOT_TOKEN=123456:ABC...
# შენი Telegram ID (ბოტში /myid). რამდენიმე: 111,222
ADMIN_IDS=123456789
# ცალკე, ახალი Phantom საფულის private key (base58)
PRIVATE_KEY=
# pinata.cloud → API Keys → JWT
PINATA_JWT=
# ჯერ devnet-ზე გატესტე, მერე mainnet
CLUSTER=devnet
# Helius / QuickNode RPC (mainnet-ზე აუცილებელია, საჯარო RPC ხშირად ჭედავს)
RPC_URL=
# Upstash Redis (უფასო) — ქოინების სია რომ არ წაიშალოს
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
